---
// src/pages/list-export.astro
// Alt-Hammer Army List — read-only roster view, full-length link form.
//
// The list arrives entirely in the URL fragment (#d=…, see public/js/list-share.js);
// nothing is stored server-side, so this page is a static shell. It decodes the
// fragment, fetches that faction's JSON exactly as the builder does, and renders the
// roster from LB.listSummary() — pricing it with the same engine the builder uses, so
// an exported roster and the builder can never disagree.
//
// The short-link form of the same page is src/pages/r/[id].astro.

import BaseLayout from '../layouts/BaseLayout.astro';
import RosterSheet from '../components/RosterSheet.astro';
---

<BaseLayout title="Army List" activePage="list-builder" showSidebar={false}>
  <RosterSheet />
</BaseLayout>
